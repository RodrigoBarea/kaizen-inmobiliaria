# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=inmobiliaria_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mapbox Token (Opcional, si no se coloca se muestra mapa OpenStreetMap con marcadores)
NEXT_PUBLIC_MAPBOX_TOKEN=

# WhatsApp de Contacto Inmobiliaria
NEXT_PUBLIC_WHATSAPP_NUMBER=59170000000
